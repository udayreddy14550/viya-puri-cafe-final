# Copy this file to ".env" (npm run setup does it for you, with a fresh SESSION_SECRET).
# NEVER commit the real .env file or share it.

# "development" on your computer, "production" when deployed (turns on Secure cookies, HSTS and the https redirect)
NODE_ENV=development
PORT=3000
# Use 127.0.0.1 normally and behind a reverse proxy. Use 0.0.0.0 only if you must expose the app directly.
HOST=127.0.0.1

# REQUIRED in production: a random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

DATABASE_PATH=data/viya.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=3

# Absolute session lifetime (hours) and sign-out after this many idle minutes
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
# Failed logins before an account is locked, and for how many minutes
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Behind nginx/Caddy/a load balancer? Set TRUST_PROXY=true so client IPs and https are read from X-Forwarded-* headers.
TRUST_PROXY=false
# Public address of the site, used to verify where admin requests come from. Example: https://viyapuricafe.example
PUBLIC_ORIGIN=
# COOKIE_SECURE=true   (defaults to true in production)
# FORCE_HTTPS=true     (defaults to true in production)
